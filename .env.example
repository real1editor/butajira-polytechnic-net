# Required: Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: canonical site URL used for metadata/Open Graph tags.
# In production set this to your deployed origin, e.g. https://network.example.edu.et
NEXT_PUBLIC_SITE_URL=http://localhost:3000
